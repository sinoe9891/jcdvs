# Requerida: clave de la API de OpenAI (ChatGPT) para el chatbot.
# Consíguela en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opcional: solo si querés que el formulario de contacto guarde los
# mensajes en MongoDB Atlas. Si la dejás vacía, el formulario sigue
# funcionando (los mensajes solo se registran en el log del servidor).
MONGODB_URI=
